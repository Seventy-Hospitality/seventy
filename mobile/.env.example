# Club70 mobile: public (EXPO_PUBLIC_*) build-time config. Copy to `.env`.
# Everything here is inlined into the app bundle, so never put a secret here
# (the Supabase anon key and the Stripe publishable key are public by design).

# Supabase project behind Clutch (auth runs on-device through supabase-js).
# Local Clutch stack: http://127.0.0.1:54321 and the local anon key printed by
# `npx supabase status` in the club-management checkout.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Clutch HTTP API, including /api/v1. Production:
# https://club-management-web.vercel.app/api/v1
EXPO_PUBLIC_CLUTCH_API_URL=http://localhost:3000/api/v1

# The Clutch club this app serves (Club 70 = "Seventy", slug 770). The app
# checks at startup that the id resolves to EXPO_PUBLIC_CLUB_SLUG.
EXPO_PUBLIC_CLUB_ID=15e24f5f-ee39-4154-8ad6-06942d06cb8a
EXPO_PUBLIC_CLUB_SLUG=770

# Web origin used to build shareable group invite links.
EXPO_PUBLIC_WEB_URL=https://club-management-web.vercel.app

# Stripe publishable key of the CLUTCH PLATFORM account (pk_test_/pk_live_).
# Club charges are direct charges on the club's connected account; the app
# scopes each sheet to that account. Empty disables PaymentSheet.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Apple merchant id for Apple Pay in PaymentSheet (optional).
EXPO_PUBLIC_STRIPE_MERCHANT_ID=merchant.club.seventy.mobile

# Google OAuth client IDs (native ID-token flow). Each must also be listed as
# an authorized client id on the Supabase Google provider. Any absent: the
# Google button shows "not configured".
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Sign in with Apple services id (web audience / Android). iOS uses the native
# flow (bundle id club.seventy.mobile must be an authorized client id on the
# Supabase Apple provider) and needs no value here.
EXPO_PUBLIC_APPLE_CLIENT_ID=
